# ============================================================
# database/.htaccess
# Folder ini hanya berisi file skema SQL untuk keperluan setup
# awal database -- tidak pernah diakses langsung lewat browser.
# Blokir seluruh akses langsung ke folder ini.
# ============================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
