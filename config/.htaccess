# ============================================================
# config/.htaccess
# Folder ini hanya berisi file yang dipanggil lewat include()/
# require() dari PHP lain -- tidak pernah diakses langsung lewat
# browser. Blokir seluruh akses langsung ke folder ini.
# ============================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
